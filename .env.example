# Konfigurasi Keamanan JWT
SECRET_KEY=ubah-dengan-secret-key-yang-kuat-di-production
JWT_ALGORITHM=HS256

# Pengaturan Presensi
QR_VALID_MINUTES=15
HADIR_WINDOW_MINUTES=15
TERLAMBAT_MAX_MINUTES=30
ATTENDANCE_WARNING_THRESHOLD=75.0
APP_TIMEZONE=Asia/Jakarta

# Pengaturan Rate Limiting (Anti Spam Scan)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Database
DATABASE_URL=sqlite:///./attendance.db

# Opsional: API Key LLM untuk pengayaan AI Attendance Insights (jika kosong, otomatis pakai engine statistik lokal)
GEMINI_API_KEY=
OPENAI_API_KEY=
